# ---- Postgres (private network only; never expose to the internet) ----
POSTGRES_USER=topup
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=topup
DATABASE_URL=postgresql://topup:change-me-strong-password@postgres:5432/topup?schema=public

# ---- Redis (private network only) ----
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-me-strong-redis-password

# ---- Application ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Base URL used for absolute links and webhook callbacks behind the proxy.
PUBLIC_BASE_URL=https://api.example.com

# ---- Secrets (generate with: openssl rand -base64 48) ----
JWT_SECRET=replace-with-a-long-random-secret
API_KEY_PEPPER=replace-with-a-long-random-secret
# 32 bytes, base64 (generate with: openssl rand -base64 32)
CREDENTIAL_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key

# ---- Reseller / business limits ----
MAX_RESELLER_DEPTH=3

# ---- AI (optional; mock gateway used when unset) ----
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1000

# ---- Monitoring / alerting (transport credentials via env only) ----
# Alert channel identifiers (e.g. Telegram chat id, email recipients). Secret tokens
# are supplied separately and never committed.
ALERT_CHANNEL_ID=
# PagerDuty / webhook endpoint (optional)
ALERT_WEBHOOK_URL=
# Backup retention (days). Do not change without business approval.
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ---- Backup encryption (32-byte base64 key, generate with: openssl rand -base64 32) ----
BACKUP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
# Off-server backup destination (S3-compatible or SSH target), e.g. s3://bucket/prefix
BACKUP_DESTINATION=

# ---- Reverse proxy / TLS ----
# Comma-separated allowlist of seller custom domains that may be routed (owned/verified).
# Never issue certificates for unverified domains.
CADDY_ACME_EMAIL=ops@example.com
# Primary API hostname.
DOMAIN=api.example.com