# Contoh environment variables untuk Cloudflare Pages (frontend).
# Salin ke Cloudflare Pages → Settings → Environment variables.
# JANGAN letak nilai rahsia (API key) di sini — ini hanya untuk frontend statik.

# URL asal backend API anda di Coolify (untuk functions proxy).
# NOTA: ini ialah alamat yang menghala ke service "api" sebenar,
# BUKAN panel Coolify (port 8000). Sahkan di Coolify → service "api".
API_ORIGIN=https://api.tokomeyrn.web.id

# Base URL awam (digunakan oleh backend untuk pautan, jika diperlukan).
PUBLIC_BASE_URL=https://tokomeyrn.web.id

# Google OAuth client ID (Public) — untuk butang Google Sign-In.
# Ini BUKAN rahsia (client ID memang awam; tiada client secret diperlukan).
# Salin dari Google Cloud Console → APIs & Services → Credentials.
# Kalau kosong, butang Google tidak akan dipaparkan.
VITE_GOOGLE_CLIENT_ID=
